# =============================================================================
# Sudoku Quest — Variables d'environnement
# Copier ce fichier vers .env.local et renseigner les valeurs.
# =============================================================================

# --- Base de données (PostgreSQL / Supabase) ---
# Local + prisma db push : Direct connection (port 5432, db.xxx.supabase.co)
# Vercel (prod) : Transaction pooler (port 6543) — Supabase → Connect → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optionnel en local pour les migrations Prisma :
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Auth.js (NextAuth v5) ---
NEXTAUTH_URL="http://localhost:3000"
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=""

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="Sudoku Quest <onboarding@resend.dev>"

# --- Upstash Redis (classements, duels) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Stripe (étape 11 — abonnement premium, mode test) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Web Push (étape 10 — notifications) ---
# VAPID keys — générer avec web-push ou service tiers
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Cron (Vercel) ---
# Secret pour sécuriser les routes cron Vercel
CRON_SECRET=""
