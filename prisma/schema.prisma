generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum League {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum DailyGoal {
  ONE
  THREE
  UNLIMITED
}

enum Motivation {
  RELAX
  PERFORMANCE
  COMPETITION
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  image             String?
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActivityDate  DateTime?
  totalXp           Int       @default(0)
  hearts            Int       @default(5)
  hints             Int       @default(5)
  gems              Int       @default(0)
  league            League    @default(BRONZE)
  timezone          String    @default("Europe/Paris")
  isPremium         Boolean   @default(false)
  dailyGoal         DailyGoal @default(ONE)
  motivation        Motivation?
  startingLevel     String?
  onboardingDone    Boolean   @default(false)
  lastHeartLostAt   DateTime?
  streakFreezes     Int       @default(0)
  pushSubscription  Json?
  storyLevelUnlocked Int       @default(1)
  storyBeatsUnlocked Int[]      @default([])
  lastResourcesResetKey String?

  accounts          Account[]
  sessions          Session[]
  attempts          UserPuzzleAttempt[]
  techniqueMasteries UserTechniqueMastery[]
  badges            UserBadge[]
  friendships       Friendship[]           @relation("UserFriendships")
  friendOf          Friendship[]           @relation("FriendOf")
  leagueParticipants LeagueParticipant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PuzzleTemplate {
  id                 String   @id @default(cuid())
  difficulty         String
  gridInitial        Json
  gridSolution       Json
  techniquesRequired String[]
  isDailyChallenge   Boolean  @default(false)
  dailyChallengeDate DateTime?
  createdAt          DateTime @default(now())
  attempts           UserPuzzleAttempt[]
}

model UserPuzzleAttempt {
  id               String         @id @default(cuid())
  userId           String
  puzzleTemplateId String
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  timeSpentSeconds Int?
  mistakesCount    Int            @default(0)
  hintsUsed        Int            @default(0)
  xpEarned         Int            @default(0)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleTemplate   PuzzleTemplate @relation(fields: [puzzleTemplateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([puzzleTemplateId])
}

model Technique {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  unitOrder   Int
  masteries   UserTechniqueMastery[]
}

model UserTechniqueMastery {
  userId                   String
  techniqueId              String
  timesAppliedSuccessfully Int      @default(0)
  masteryLevel             Int      @default(0)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  technique                Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@id([userId, techniqueId])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model Friendship {
  id        String           @id @default(cuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  user      User             @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend    User             @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model LeagueSnapshot {
  id           String              @id @default(cuid())
  weekStart    DateTime
  leagueName   League
  participants LeagueParticipant[]
}

model LeagueParticipant {
  userId           String
  leagueSnapshotId String
  xpThisWeek       Int            @default(0)
  rank             Int?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leagueSnapshot   LeagueSnapshot @relation(fields: [leagueSnapshotId], references: [id], onDelete: Cascade)

  @@id([userId, leagueSnapshotId])
}
